# ASTRA Cloud — Backend Environment Configuration Example
# Copy this file to .env and adjust variables for your local PostgreSQL setup.
# IMPORTANT: .env is excluded from git in .gitignore. Never commit real credentials.

ASTRA_DB_HOST=localhost
ASTRA_DB_PORT=5432
ASTRA_DB_NAME=astra_cloud
ASTRA_DB_USER=openpg
ASTRA_DB_PASSWORD=your_password_here

# API Configuration
ASTRA_API_HOST=127.0.0.1
ASTRA_API_PORT=8000
ASTRA_API_DEBUG=false

# Neo4j Knowledge Graph Configuration
ASTRA_NEO4J_URI=bolt://localhost:7687
ASTRA_NEO4J_USER=neo4j
ASTRA_NEO4J_PASSWORD=your_neo4j_password_here
ASTRA_NEO4J_DATABASE=neo4j

# MLflow Experiment Tracking Configuration
ASTRA_MLFLOW_TRACKING_URI=file:///e:/ASTRA%20CLOUD/backend/data/mlruns
ASTRA_MLFLOW_UI_URL=http://localhost:5000
